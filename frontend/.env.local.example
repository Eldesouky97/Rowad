# ==== Firebase Admin SDK (سيرفر فقط، بدون NEXT_PUBLIC_) ====
# مطلوب فقط لحذف حسابات المستخدمين نهائيًا من لوحة التحكم (app/api/admin/delete-user).
# احصل عليها من: Firebase Console → إعدادات المشروع → Service Accounts →
# Generate New Private Key (بيحمّل ملف JSON فيه القيم التلاتة دي).
# FIREBASE_ADMIN_PRIVATE_KEY لازم تُكتب بين علامتي تنصيص وبـ \n مكان كل سطر جديد.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
