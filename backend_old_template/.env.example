APP_NAME="Rowwad Al-Mohafazat Al-Hodoudiya"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# نطاق الواجهة الأمامية (Next.js) المسموح له بالوصول للـ API + بجلسات Sanctum
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# الأبسط للتشغيل المحلي: SQLite (لا يحتاج تثبيت خادم قاعدة بيانات)
DB_CONNECTION=sqlite
# لاستخدام MySQL بدلاً من ذلك، علّق السطر السابق وفعّل الأسطر التالية:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rowwad
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
